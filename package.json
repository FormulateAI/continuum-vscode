{
  "name": "continuum-vscode",
  "displayName": "Continuum Context Hub",
  "description": "Persistent AI memory for your codebase — store decisions, conventions, and architecture notes that any AI agent can recall instantly.",
  "version": "0.2.3",
  "publisher": "FormulateAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/FormulateAI/continuum-vscode"
  },
  "bugs": {
    "url": "https://github.com/FormulateAI/continuum-vscode/issues"
  },
  "homepage": "https://github.com/FormulateAI/continuum-vscode#readme",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "ai memory",
    "context hub",
    "continuum",
    "claude",
    "cursor",
    "copilot",
    "ai agent",
    "project knowledge",
    "llm context",
    "developer productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "continuum.connect",
        "title": "Context Hub: Connect",
        "category": "Context Hub"
      },
      {
        "command": "continuum.remember",
        "title": "Context Hub: Save Memory",
        "category": "Context Hub"
      },
      {
        "command": "continuum.recall",
        "title": "Context Hub: Search Memories",
        "category": "Context Hub"
      },
      {
        "command": "continuum.showContext",
        "title": "Context Hub: View Project Context",
        "category": "Context Hub"
      },
      {
        "command": "continuum.pushSelection",
        "title": "Context Hub: Save Selection as Memory",
        "category": "Context Hub"
      },
      {
        "command": "continuum.refreshMemories",
        "title": "Context Hub: Refresh",
        "category": "Context Hub"
      },
      {
        "command": "continuum.deleteMemory",
        "title": "Context Hub: Delete Memory",
        "category": "Context Hub"
      },
      {
        "command": "continuum.copyMemoryContent",
        "title": "Context Hub: Copy Memory",
        "category": "Context Hub"
      },
      {
        "command": "continuum.editMemory",
        "title": "Context Hub: Edit Memory",
        "category": "Context Hub"
      },
      {
        "command": "continuum.showServerLogs",
        "title": "Context Hub: Show Server Logs",
        "category": "Context Hub"
      }
    ],
    "keybindings": [
      {
        "command": "continuum.remember",
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m",
        "when": "editorFocus"
      },
      {
        "command": "continuum.recall",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "continuum.pushSelection",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "editorHasSelection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "continuum",
          "title": "Context Hub",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "continuum": [
        {
          "id": "continuum-memories",
          "name": "Project Memory"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "continuum-memories",
        "contents": "No project memories yet.\n\nContext Hub stores your team's architectural decisions, coding conventions, and key patterns so AI agents can recall them automatically.\n\n**Step 1:** Connect to the Context Hub server.\n[Connect to Context Hub](command:continuum.connect)\n\n**Step 2:** Save your first memory.\n[Save a Memory](command:continuum.remember)\n\nNeed help? [View Documentation](https://github.com/FormulateAI/continuum-vscode#readme)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "continuum.editMemory",
          "when": "view == continuum-memories && viewItem == memory",
          "group": "1_modify@1"
        },
        {
          "command": "continuum.copyMemoryContent",
          "when": "view == continuum-memories && viewItem == memory",
          "group": "1_modify@2"
        },
        {
          "command": "continuum.deleteMemory",
          "when": "view == continuum-memories && viewItem == memory",
          "group": "9_delete@1"
        }
      ],
      "editor/context": [
        {
          "command": "continuum.pushSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@10"
        }
      ]
    },
    "configuration": {
      "title": "Context Hub",
      "properties": {
        "continuum.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "markdownDescription": "URL of an externally managed Continuum server. Only used when `#continuum.serverManaged#` is `false`."
        },
        "continuum.serverManaged": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, the extension automatically starts and manages the Continuum server process. Requires `continuum-context-hub` to be installed (`pip install continuum-context-hub`)."
        },
        "continuum.serverPort": {
          "type": "number",
          "default": 8111,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Port for the managed Continuum server. Only used when `#continuum.serverManaged#` is `true`."
        },
        "continuum.autoPushOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically record a lightweight memory entry each time you save a file. Useful for tracking which files were recently modified."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}
